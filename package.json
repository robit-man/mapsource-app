{
  "name": "mapsource-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A production example hiking and route-planning application built with the Mapsource npm package.",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "4.0.2"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c green,cyan \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run clean && tsc -b && vite build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "deploy:check": "node scripts/deployment-check.mjs",
    "deploy:check:interaction": "node scripts/live-navigation-check.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "maplibre-gl": "6.11.2",
    "mapsource": "0.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.3.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "9.2.4",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.22",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
